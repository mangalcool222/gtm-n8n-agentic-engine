{
  "name": "01 - Job Hunter Auto-Pilot (Feed -> Gemini AI -> Trello + Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "trigger-6h",
      "name": "Every 6 Hours Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://remotive.com/api/remote-jobs?category=product&limit=25",
        "options": {}
      },
      "id": "fetch-jobs",
      "name": "Fetch PM Jobs API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Get raw jobs array\nconst allJobs = $input.first().json.jobs || [];\n\n// 2. Pre-filter: drop strict physical presence or ultra-senior 10+ yr executive roles\nconst preFiltered = allJobs.filter(job => {\n  const loc = (job.candidate_required_location || \"\").toLowerCase();\n  const title = (job.title || \"\").toLowerCase();\n  \n  // Must allow remote / worldwide / india or no strict physical local office\n  const isEligibleLocation = loc.includes(\"worldwide\") || loc.includes(\"anywhere\") || loc.includes(\"remote\") || loc.includes(\"india\") || loc === \"\";\n  \n  // Exclude purely executive or heavy hardware/clinical titles\n  const isExecutiveOrIrrelevant = title.includes(\"director\") || title.includes(\"vice president\") || title.includes(\"chief \") || title.includes(\"nurse\") || title.includes(\"physician\");\n  \n  return isEligibleLocation && !isExecutiveOrIrrelevant;\n});\n\n// 3. Take Top 8 jobs per run (comfortably within Google 15 RPM with batching)\nconst selected = preFiltered.slice(0, 8);\n\nreturn selected.map(job => ({ json: job }));\n"
      },
      "id": "split-jobs",
      "name": "Split Jobs Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key={{GEMINI_API_KEY}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={{ [{ parts: [{ text: `You are an expert GTM, Product, Growth & Operations Career Filter for Mangal.\\n\\nREJECT IMMEDIATELY (Respond ONLY with the word 'SKIP') if ANY of the following conditions are met:\\n1. HARD SENIORITY CAP: The role explicitly requires 7+ or 10+ years of experience, VP, Executive, or Principal/Staff Architect level.\\n2. PHYSICAL LOCAL OFFICE REQUIREMENT: Explicitly requires local physical office presence in non-eligible countries (e.g. 'Must relocate to London office', 'In-person NYC office 4 days/week'). Accept Worldwide Remote, Remote India, or Global Remote.\\n3. COMPLETELY UNRELATED DOMAIN: Clinical nursing, medical practice, physical sports coaching, heavy civil hardware.\\n\\nACCEPTABLE (Generate Pitch):\\nAccept all Product Management, APM, Product Ops, Growth, GTM, Founder's Office, Strategy & Ops, Business/Data Analyst, Marketing, AI/Automation Builder roles (0-5 yrs or flexible experience).\\n\\nGenerate a 3-bullet customized pitch for Mangal highlighting:\\n- Product, Growth & Business thinking alignment.\\n- Technical execution & automation (n8n, Python, APIs).\\n- Scrappy 0-to-1 startup mindset.\\n\\nJob Title: ${$json.title || ''}\\nCompany: ${$json.company_name || ''}\\nLocation: ${$json.candidate_required_location || ''}\\nDescription: ${($json.description || '').replace(/<[^>]*>?/gm, '').slice(0, 1000)}` }] }] }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 4000
            }
          }
        }
      },
      "id": "gemini-ai",
      "name": "Gemini AI Pitch Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "check-skip",
              "leftValue": "={{ $json.candidates[0].content.parts[0].text.trim() }}",
              "rightValue": "SKIP",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ]
        }
      },
      "id": "filter-skip",
      "name": "Filter Out Irrelevant Jobs",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "{{TRELLO_API_KEY}}"
            },
            {
              "name": "token",
              "value": "{{TRELLO_TOKEN}}"
            },
            {
              "name": "idList",
              "value": "{{TRELLO_WISHLIST_LIST_ID}}"
            },
            {
              "name": "name",
              "value": "=\ud83d\udd25 {{ $(\"Split Jobs Array\").item.json.title }} - {{ $(\"Split Jobs Array\").item.json.company_name }}"
            },
            {
              "name": "desc",
              "value": "=\ud83d\udccc **Job URL:** {{ $(\"Split Jobs Array\").item.json.url }}\n\ud83d\udccd **Location:** {{ $(\"Split Jobs Array\").item.json.candidate_required_location }}\n\ud83c\udf93 **Profile Fit:** Flexible Remote Match (Product / Growth / Ops)\n\ud83d\udd17 **Application URL:** Verified Active Link\n\n\ud83e\udd16 **Gemini AI Customized Pitch:**\n{{ $json.candidates[0].content.parts[0].text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "trello-card",
      "name": "Create Trello Card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://script.google.com/macros/s/AKfycbxUBfYOX-PGMm7HtHhbP56WTtQYhJZqrb8qPvbllvzHKnUXGA8qlLgwN8I0UMa05DdC/exec",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "dateAdded",
              "value": "={{ $now.format(\"yyyy-MM-dd HH:mm\") }}"
            },
            {
              "name": "company",
              "value": "={{ $(\"Split Jobs Array\").item.json.company_name }}"
            },
            {
              "name": "jobTitle",
              "value": "={{ $(\"Split Jobs Array\").item.json.title }}"
            },
            {
              "name": "location",
              "value": "={{ $(\"Split Jobs Array\").item.json.candidate_required_location }}"
            },
            {
              "name": "jobUrl",
              "value": "={{ $(\"Split Jobs Array\").item.json.url }}"
            },
            {
              "name": "status",
              "value": "Wishlist"
            },
            {
              "name": "aiPitch",
              "value": "={{ $json.candidates[0].content.parts[0].text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "sheets-webhook",
      "name": "Push to Google Sheets Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        420
      ]
    }
  ],
  "connections": {
    "Every 6 Hours Trigger": {
      "main": [
        [
          {
            "node": "Fetch PM Jobs API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch PM Jobs API": {
      "main": [
        [
          {
            "node": "Split Jobs Array",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Jobs Array": {
      "main": [
        [
          {
            "node": "Gemini AI Pitch Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini AI Pitch Generator": {
      "main": [
        [
          {
            "node": "Filter Out Irrelevant Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Out Irrelevant Jobs": {
      "main": [
        [
          {
            "node": "Create Trello Card",
